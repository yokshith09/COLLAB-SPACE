# Database (Supabase PostgreSQL or any PostgreSQL)
# Recommended on Vercel: Supabase Transaction Pooler URL.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Optional compatibility aliases if your host still references NextAuth naming.
NEXTAUTH_SECRET="same-value-as-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (for Realtime chat + file storage)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
# Newer Supabase projects show this as the browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Older Supabase projects can use the anon JWT instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Email (Resend)
RESEND_API_KEY="re_..."
NEXT_PUBLIC_APP_EMAIL="notifications@collabspace.app"
